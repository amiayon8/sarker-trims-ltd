{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/product-range/layout,_N_T_/product-range/page,_N_T_/product-range"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/product-range/__PAGE__",
    "/product-range",
    "/_index",
    "/_head"
  ]
}