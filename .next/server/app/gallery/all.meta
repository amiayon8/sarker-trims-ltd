{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/gallery/layout,_N_T_/gallery/[category]/layout,_N_T_/gallery/[category]/page,_N_T_/gallery/all"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/gallery/$d$category/__PAGE__",
    "/gallery/$d$category",
    "/gallery",
    "/_index",
    "/_head"
  ]
}